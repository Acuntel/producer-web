{
  "name": "producer-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "/Users/bradyschwartz/.npm/_npx/17e7e13df003209e/node_modules/.bin/tsx --test tests/*.test.mjs",
    "e2e": "E2E_SKIP_SELFTEST=1 node tests/e2e.mjs http://localhost:3111",
    "speak": "node tests/speak.e2e.mjs http://localhost:3111",
    "shots": "node tests/stage.shot.mjs http://localhost:3111 /tmp/producer-shots 1440 900 && node tests/stage.shot.mjs http://localhost:3111 /tmp/producer-shots 390 844",
    "serve": "next start -p 3111",
    "deploy": "./tools/deploy.sh",
    "ritual": "node tests/ritual.e2e.mjs http://localhost:3111",
    "serve:mock": "PRODUCER_MOCK=1 next start -p 3111",
    "battery": "node tests/voice.battery.mjs http://localhost:3111",
    "battery:song": "node --import ./tests/ts-resolve.mjs tests/brain-battery.mjs http://localhost:3111",
    "audible": "node tests/audible.mjs http://localhost:3111",
    "glitch": "node tests/glitch.probe.mjs http://localhost:3111",
    "vocal": "node tests/vocal.probe.mjs http://localhost:3111",
    "learn": "node --import ./tests/ts-resolve.mjs tests/learn.probe.mjs"
  },
